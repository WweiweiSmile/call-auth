# 复制成 .env 再填。真密钥只放 .env，这个文件永远留空。

# ---------- 数据库 ----------
# 刻意指向 **call-back 的库**：users 表是身份权威源，它的 id 被所有业务表
# 当外键引用，搬走要改遍全库外键。见《认证中心设计文档》§4.4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=call_game

# ---------- 服务 ----------
SERVER_PORT=8020

# ---------- 签名密钥 ----------
# RS256 私钥路径。**必填，没有默认值** —— 密钥一旦有兜底，漏配就不会报错。
# 文件不存在时会自动生成一把并写进去（本地开发方便）；生产上如果启动日志里
# 出现「已生成新密钥」，说明路径配错了或文件被删了，要立刻处理：
# 换密钥意味着所有已发出的 token 立刻失效。
# 手动生成：openssl genrsa -out keys/private.pem 2048
AUTH_PRIVATE_KEY_PATH=./keys/private.pem

# ---------- 令牌 ----------
# 签发者标识，各服务验签时校验它
AUTH_ISSUER=call-auth
# 允许使用本服务签发的 token 的服务列表。
# 认证中心自己会被自动加进去（它的 /auth/me 也要鉴权），不用手写
AUTH_AUDIENCES=call-back,learn-daily
# access token 有效期（秒）。15 分钟：短过期是无状态 JWT 能接受的原因之一，
# 登出最多 15 分钟后彻底生效
ACCESS_TOKEN_TTL_SECONDS=900
# refresh token 有效期（秒）。14 天
REFRESH_TOKEN_TTL_SECONDS=1209600
# 允许的时钟偏差（秒）
JWT_LEEWAY_SECONDS=60

# ---------- 跨应用 SSO ----------
# 一次性票据有效期（秒）。60 秒够走完一次跳转；越短越安全 ——
# 票据会出现在地址栏和浏览历史里（§4.5）
SSO_TICKET_TTL_SECONDS=60
# 认证中心域下会话 cookie 的有效期（秒）。30 天。
# 它是「一段时间内不用重复登录」的来源，也是泄露代价最高的一份凭据
SSO_SESSION_TTL_SECONDS=2592000
# SSO 会话 cookie 是否带 Secure 属性。
# 生产（Caddy 挡在前面）→ true；本机 http://localhost:8020 开发 → false。
# **不要硬编码**：本机配成 true 时浏览器根本不存这个 cookie，
# 表现是 /sso 永远读不到会话、死循环跳登录页（§6.2.1、§10.2）
COOKIE_SECURE=false

# ---------- CORS ----------
# 允许的前端源，逗号分隔。为空则浏览器端一律被挡。
# 生产要补上 https://call.qwnet.top,https://learn.qwnet.top ——
# 注意只列**需要跨域调 API** 的源；登录页和 /sso 是同源导航，不需要列在这
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,https://call.qwnet.top,https://learn.qwnet.top
